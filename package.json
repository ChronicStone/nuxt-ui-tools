{
  "name": "nuxt-ui-tools",
  "version": "0.1.3",
  "description": "Nuxt module and runtime toolkit for UI-heavy Nuxt applications",
  "homepage": "https://github.com/ChronicStone/nuxt-ui-tools#readme",
  "bugs": "https://github.com/ChronicStone/nuxt-ui-tools/issues",
  "license": "MIT",
  "repository": "github:ChronicStone/nuxt-ui-tools",
  "workspaces": [
    "playground"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "form": [
        "./dist/runtime/form/index.d.ts"
      ],
      "i18n": [
        "./dist/runtime/i18n/index.d.ts"
      ],
      "query-state": [
        "./dist/runtime/query-state/index.d.ts"
      ],
      "shared": [
        "./dist/runtime/shared/index.d.ts"
      ],
      "table": [
        "./dist/runtime/table/index.d.ts"
      ]
    }
  },
  "imports": {
    "#ui-tools/form": {
      "types": "./dist/runtime/form/index.d.ts",
      "default": "./dist/runtime/form/index.js"
    },
    "#ui-tools/form/*": {
      "types": "./dist/runtime/form/*.d.ts",
      "default": "./dist/runtime/form/*.js"
    },
    "#ui-tools/i18n": {
      "types": "./dist/runtime/i18n/index.d.ts",
      "default": "./dist/runtime/i18n/index.js"
    },
    "#ui-tools/i18n/*": {
      "types": "./dist/runtime/i18n/*.d.ts",
      "default": "./dist/runtime/i18n/*.js"
    },
    "#ui-tools/query-state": {
      "types": "./dist/runtime/query-state/index.d.ts",
      "default": "./dist/runtime/query-state/index.js"
    },
    "#ui-tools/query-state/*": {
      "types": "./dist/runtime/query-state/*.d.ts",
      "default": "./dist/runtime/query-state/*.js"
    },
    "#ui-tools/shared": {
      "types": "./dist/runtime/shared/index.d.ts",
      "default": "./dist/runtime/shared/index.js"
    },
    "#ui-tools/shared/*": {
      "types": "./dist/runtime/shared/*.d.ts",
      "default": "./dist/runtime/shared/*.js"
    },
    "#ui-tools/table": {
      "types": "./dist/runtime/table/index.d.ts",
      "default": "./dist/runtime/table/index.js"
    },
    "#ui-tools/table/*": {
      "types": "./dist/runtime/table/*.d.ts",
      "default": "./dist/runtime/table/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./form": {
      "types": "./dist/runtime/form/index.d.ts",
      "import": "./dist/runtime/form/index.js"
    },
    "./i18n": {
      "types": "./dist/runtime/i18n/index.d.ts",
      "import": "./dist/runtime/i18n/index.js"
    },
    "./query-state": {
      "types": "./dist/runtime/query-state/index.d.ts",
      "import": "./dist/runtime/query-state/index.js"
    },
    "./shared": {
      "types": "./dist/runtime/shared/index.d.ts",
      "import": "./dist/runtime/shared/index.js"
    },
    "./table": {
      "types": "./dist/runtime/table/index.d.ts",
      "import": "./dist/runtime/table/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "build": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "release": "npm run check && npm run build && changelogen --release",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "NODE_OPTIONS=\"--max-old-space-size=4096\" vue-tsc --noEmit",
    "typecheck:playground": "cd playground && npm run typecheck",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "clean": "rm -rf dist .nuxt node_modules playground/.nuxt playground/.output playground/node_modules"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.0",
    "@nuxt/kit": "^4.4.2",
    "@tanstack/pacer": "0.19.0",
    "@tanstack/vue-virtual": "3.13.23",
    "@vueuse/core": "14.2.1",
    "cookiejs": "2.1.3",
    "libphonenumber-js": "1.13.1",
    "motion-v": "2.0.1",
    "nuxt-viewport": "2.4.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.2",
    "@nuxt/ui": "^4.5.1",
    "@types/node": "25.4.0",
    "changelogen": "^0.6.2",
    "nuxt": "^4.4.2",
    "oxfmt": "0.38.0",
    "oxlint": "1.53.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5",
    "xlsx": "0.18.5"
  },
  "peerDependencies": {
    "@nuxt/ui": ">=4.5.1",
    "@tanstack/vue-query": ">=5.0.0",
    "nuxt": ">=4.4.0",
    "tailwindcss": ">=4.0.0",
    "vue": ">=3.5.0",
    "vue-draggable-plus": ">=0.6.0",
    "vue-router": ">=4.5.0"
  }
}
