{
  "name": "nuxt-ui-tools",
  "private": true,
  "workspaces": [
    "packages/*",
    "playgrounds/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "check": "bun run format:check && bun run lint && bun run build && bun run typecheck",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@tsdown/css": "0.21.1",
    "@types/node": "25.4.0",
    "@vitejs/plugin-vue": "6.0.4",
    "oxfmt": "0.38.0",
    "oxlint": "1.53.0",
    "tsdown": "0.21.1",
    "turbo": "2.8.16",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vue-tsc": "3.2.5"
  },
  "packageManager": "bun@1.3.6"
}
