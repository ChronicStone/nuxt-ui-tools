{
  "name": "nuxt-ui-tools",
  "version": "1.5.0",
  "description": "Nuxt module and runtime toolkit for UI-heavy Nuxt applications",
  "homepage": "https://github.com/ChronicStone/nuxt-ui-tools#readme",
  "bugs": "https://github.com/ChronicStone/nuxt-ui-tools/issues",
  "license": "MIT",
  "repository": "github:ChronicStone/nuxt-ui-tools",
  "workspaces": [
    "playground",
    "playground-table"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "dashboard": [
        "./dist/runtime/dashboard/index.d.ts"
      ],
      "form": [
        "./dist/runtime/form/index.d.ts"
      ],
      "i18n": [
        "./dist/runtime/i18n/index.d.ts"
      ],
      "query-state": [
        "./dist/runtime/query-state/index.d.ts"
      ],
      "query-prefetch": [
        "./dist/runtime/query-prefetch/index.d.ts"
      ],
      "shared": [
        "./dist/runtime/shared/index.d.ts"
      ],
      "table": [
        "./dist/runtime/table/index.d.ts"
      ]
    }
  },
  "imports": {
    "#ui-tools/dashboard": {
      "types": "./dist/runtime/dashboard/index.d.ts",
      "default": "./dist/runtime/dashboard/index.js"
    },
    "#ui-tools/dashboard/*": {
      "types": "./dist/runtime/dashboard/*.d.ts",
      "default": "./dist/runtime/dashboard/*.js"
    },
    "#ui-tools/form": {
      "types": "./dist/runtime/form/index.d.ts",
      "default": "./dist/runtime/form/index.js"
    },
    "#ui-tools/form/*": {
      "types": "./dist/runtime/form/*.d.ts",
      "default": "./dist/runtime/form/*.js"
    },
    "#ui-tools/i18n": {
      "types": "./dist/runtime/i18n/index.d.ts",
      "default": "./dist/runtime/i18n/index.js"
    },
    "#ui-tools/i18n/*": {
      "types": "./dist/runtime/i18n/*.d.ts",
      "default": "./dist/runtime/i18n/*.js"
    },
    "#ui-tools/query-state": {
      "types": "./dist/runtime/query-state/index.d.ts",
      "default": "./dist/runtime/query-state/index.js"
    },
    "#ui-tools/query-state/*": {
      "types": "./dist/runtime/query-state/*.d.ts",
      "default": "./dist/runtime/query-state/*.js"
    },
    "#ui-tools/query-prefetch": {
      "types": "./dist/runtime/query-prefetch/index.d.ts",
      "default": "./dist/runtime/query-prefetch/index.js"
    },
    "#ui-tools/query-prefetch/*": {
      "types": "./dist/runtime/query-prefetch/*.d.ts",
      "default": "./dist/runtime/query-prefetch/*.js"
    },
    "#ui-tools/shared": {
      "types": "./dist/runtime/shared/index.d.ts",
      "default": "./dist/runtime/shared/index.js"
    },
    "#ui-tools/shared/*": {
      "types": "./dist/runtime/shared/*.d.ts",
      "default": "./dist/runtime/shared/*.js"
    },
    "#ui-tools/table": {
      "types": "./dist/runtime/table/index.d.ts",
      "default": "./dist/runtime/table/index.js"
    },
    "#ui-tools/table/*": {
      "types": "./dist/runtime/table/*.d.ts",
      "default": "./dist/runtime/table/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./dashboard": {
      "types": "./dist/runtime/dashboard/index.d.ts",
      "import": "./dist/runtime/dashboard/index.js"
    },
    "./form": {
      "types": "./dist/runtime/form/index.d.ts",
      "import": "./dist/runtime/form/index.js"
    },
    "./i18n": {
      "types": "./dist/runtime/i18n/index.d.ts",
      "import": "./dist/runtime/i18n/index.js"
    },
    "./query-state": {
      "types": "./dist/runtime/query-state/index.d.ts",
      "import": "./dist/runtime/query-state/index.js"
    },
    "./query-prefetch": {
      "types": "./dist/runtime/query-prefetch/index.d.ts",
      "import": "./dist/runtime/query-prefetch/index.js"
    },
    "./shared": {
      "types": "./dist/runtime/shared/index.d.ts",
      "import": "./dist/runtime/shared/index.js"
    },
    "./table": {
      "types": "./dist/runtime/table/index.d.ts",
      "import": "./dist/runtime/table/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "build": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:playgrounds && npm run test",
    "release": "npm run check && npm run build && changelogen --release",
    "lint": "oxlint -c oxlint.config.ts .",
    "lint:fix": "oxlint -c oxlint.config.ts --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "NODE_OPTIONS=\"--max-old-space-size=4096\" vue-tsc --noEmit",
    "typecheck:playground": "cd playground && npm run typecheck",
    "typecheck:playground-table": "cd playground-table && npm run typecheck",
    "typecheck:playgrounds": "npm run typecheck:playground && npm run typecheck:playground-table",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "clean": "rm -rf dist .nuxt node_modules playground/.nuxt playground/.output playground/node_modules",
    "dev:table": "npm run dev:prepare:table && nuxt dev playground-table --port 3100",
    "dev:prepare:table": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground-table"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "@nuxt/kit": "^4.5.2",
    "@regle/core": "1.29.1",
    "@regle/rules": "1.29.1",
    "@tanstack/pacer": "0.22.0",
    "@tanstack/vue-table": "9.2.3",
    "@tanstack/vue-virtual": "3.13.36",
    "@vueuse/core": "14.4.0",
    "cookiejs": "2.1.4",
    "libphonenumber-js": "1.13.11",
    "maska": "3.2.1",
    "motion-v": "2.4.0",
    "nuxt-viewport": "2.6.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/ui": "^4.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/y-tiptap": "3.0.9",
    "@types/node": "25.4.0",
    "@unovis/ts": "1.7.0",
    "@unovis/vue": "1.7.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/browser-playwright": "4.1.11",
    "@vue/test-utils": "2.5.1",
    "changelogen": "^0.6.2",
    "happy-dom": "20.14.5",
    "nuxt": "^4.5.2",
    "oxfmt": "0.64.0",
    "oxlint": "^1.82.0",
    "playwright": "1.63.0",
    "typescript": "~5.9.3",
    "ultracite": "7.12.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10",
    "xlsx": "0.18.5"
  },
  "peerDependencies": {
    "@nuxt/ui": ">=4.10.0",
    "@tanstack/vue-query": ">=5.101.4",
    "@unovis/ts": ">=1.6.0",
    "@unovis/vue": ">=1.6.0",
    "nuxt": ">=4.5.2",
    "tailwindcss": ">=4.3.3",
    "typescript": ">=5.9.0",
    "vue": ">=3.5.41",
    "vue-draggable-plus": ">=0.6.1",
    "vue-router": ">=4.6.4"
  },
  "peerDependenciesMeta": {
    "@unovis/ts": {
      "optional": true
    },
    "@unovis/vue": {
      "optional": true
    }
  },
  "overrides": {
    "@tiptap/y-tiptap": "3.0.9"
  }
}
