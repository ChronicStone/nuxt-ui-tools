{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["src/*"],
      "@nuxt-ui-tools/shared": ["../shared/dist/index.d.ts"]
    }
  },
  "include": [
    "src/index.ts",
