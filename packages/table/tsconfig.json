{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "allowArbitraryExtensions": true,
    "jsxImportSource": "vue",
    "paths": {
      "@lib/*": ["../shared/src/*"],
      "@nuxt-ui-tools/shared": ["../shared/src/index.ts"]
    }
  },
  "include": [
    "src/index.ts",
    "src/schema/**/*.ts",
    "src/builders/**/*.ts",
    "src/composables/*.ts",
    "src/composables/*.tsx",
    "src/utils/**/*.ts",
    "src/composables/**/*.ts",
    "src/composables/**/*.tsx",
    "src/utils/*.ts",
    "src/types/**/*.ts",
    "src/types/**/*.d.ts",
    "src/components/**/*.vue",
    "tests/**/*.ts"
  ]
}
