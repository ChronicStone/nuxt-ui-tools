{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "allowArbitraryExtensions": true,
    "jsxImportSource": "vue",
    "paths": {
      "@/*": ["./src/*"],
      "#src/*": ["./src/*"],
      "#runtime/*": ["./src/runtime/*"],
      "#shared": ["./src/runtime/shared/index.ts"],
      "#shared/*": ["./src/runtime/shared/*"],
      "#query-state": ["./src/runtime/query-state/index.ts"],
      "#query-state/*": ["./src/runtime/query-state/*"],
      "#table": ["./src/runtime/table/index.ts"],
      "#table/*": ["./src/runtime/table/*"],
      "#form": ["./src/runtime/form/index.ts"],
      "#form/*": ["./src/runtime/form/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "test/**/*.ts"],
  "exclude": ["dist", "node_modules", "playground", ".nuxt", "test/basic.test.ts", "test/fixtures"]
}
