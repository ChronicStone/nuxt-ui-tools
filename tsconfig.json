{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "allowArbitraryExtensions": true,
    "jsxImportSource": "vue",
    "paths": {
      "@/*": ["./src/*"],
      "#app": ["./node_modules/nuxt/dist/app"],
      "#app/*": ["./node_modules/nuxt/dist/app/*"],
      "#ui-tools": ["./src/runtime"],
      "#ui-tools/*": ["./src/runtime/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "test/**/*.ts"],
  "exclude": ["dist", "node_modules", "playground", ".nuxt", "test/basic.test.ts", "test/fixtures"]
}
