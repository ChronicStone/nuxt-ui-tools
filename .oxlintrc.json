{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "promise", "vue"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".turbo/**",
    ".nuxt/**",
    ".output/**",
    "coverage/**"
  ]
}
